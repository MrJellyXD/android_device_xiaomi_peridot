# Allow platform_app to execute vendor blobs it maps from its data dir
# (MiCam loads its Leica/AI algorithm plugins this way)
allow platform_app vendor_file:file { read open getattr map execute };
typeattribute platform_app system_executes_vendor_violators;
allow platform_app app_data_file:file execute;

# Camera
hal_client_domain(platform_app, hal_aidlbgservice)
hal_client_domain(platform_app, hal_camera_mivi)
hal_client_domain(platform_app, hal_quickcamera)
hal_client_domain(platform_app, hal_camera_aon)
hal_client_domain(platform_app, vendor_hal_cameraperf)
hal_client_domain(platform_app, vendor_hal_camerapostproc_xiaomi)
binder_call(platform_app, hal_camera_default)

allow platform_app adsprpcd_file:dir r_dir_perms;
allow platform_app vendor_camera_data_file:dir create_dir_perms;
allow platform_app vendor_camera_data_file:file create_file_perms;

# PSI stats (MiCam adaptive perf)
allow platform_app proc_pressure_cpu:file r_file_perms;
allow platform_app proc_pressure_io:file r_file_perms;
allow platform_app proc_pressure_mem:file r_file_perms;

get_prop(platform_app, vendor_audio_prop)
get_prop(platform_app, vendor_camera_prop)
get_prop(platform_app, vendor_camera_sensor_prop)
get_prop(platform_app, vendor_camera_p3enable_prop)
get_prop(platform_app, vendor_displayfeature_prop)
get_prop(platform_app, vendor_display_prop)
get_prop(platform_app, vendor_fp_prop)
get_prop(platform_app, vendor_panel_info_prop)
